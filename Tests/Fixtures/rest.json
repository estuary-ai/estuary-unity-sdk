      }
    },
    {
      "id": "memories.create",
      "sdk": {
        "unity": "CreateMemory"
      },
      "method": "POST",
      "path": "/api/v1/characters/char_123/players/player_1/memories",
      "json": {
        "content": "Enjoys tea",
        "memoryType": "fact"
      }
    },
    {
      "id": "memories.update",
      "sdk": {
