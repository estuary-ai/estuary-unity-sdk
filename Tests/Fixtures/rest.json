        }
      }
    },
    {
      "id": "characters.update",
      "sdk": {
        "unity": "UpdateCharacter"
      },
      "method": "PUT",
      "path": "/api/v1/characters/char_123",
      "json": {
        "persona": {
          "name": "Guide 2"
        }
      }
    },
    {
      "id": "characters.transfer",
      "sdk": {
        "unity": "TransferCharacter"
      },
      "method": "POST",
      "path": "/api/v1/characters/char_123/transfer",
      "json": {
        "destination": "org",
        "orgId": "org_1"
      }
    },
    {
      "id": "characters.motive",
      "sdk": {
        "unity": "GetCharacterMotive"
      },
      "method": "GET",
      "path": "/api/v1/characters/char_123/motive",
      "query": {
        "playerId": "player_1"
      }
    },
    {
      "id": "characters.setMotive",
      "sdk": {
        "unity": "SetCharacterMotive"
      },
      "method": "PATCH",
      "path": "/api/v1/characters/char_123/motive",
      "json": {
        "motive": "Find a friend"
      },
      "query": {
        "playerId": "player_1"
      }
    },
    {
      "id": "characters.resetMotive",
      "sdk": {
        "unity": "ResetCharacterMotive"
      },
      "method": "DELETE",
      "path": "/api/v1/characters/char_123/motive",
      "query": {
        "playerId": "player_1"
      }
    },
    {
      "id": "characters.avatar",
      "sdk": {
        "unity": "UploadAvatar"
      },
      "method": "PUT",
      "path": "/api/v1/characters/char_123/avatar"
    },
    {
      "id": "characters.modelFile",
      "sdk": {
        "unity": "UploadModel"
      },
      "method": "PUT",
      "path": "/api/v1/characters/char_123/model-file"
    },
    {
      "id": "generation.rigged",
      "sdk": {
        "unity": "GenerateModel"
      },
      "method": "POST",
      "path": "/api/v1/characters/char_123/model",
